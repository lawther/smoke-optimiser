#!/bin/sh
# Fleet-managed copy of agent_rules payload/git_hooks/pre-commit. Do not edit it here:
#      edit it there, then run `just sync` in agent_rules.
# Git pre-commit hook — runs the full justfile precommit suite before each commit.
#
# This file is version-controlled in .fleet/git_hooks/. To activate it on a fresh clone:
#
#   git config core.hooksPath .fleet/git_hooks
#
# Or run: just setup-git-hooks
#
# `set -e` is what makes a failing check refuse the commit: without it only the last
# command's status counts, and a check ahead of it can fail unnoticed.
set -e

just precommit
